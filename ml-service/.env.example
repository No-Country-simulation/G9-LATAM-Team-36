# Bloque D — Servicio ML (FastAPI). Copiar a .env y ajustar.

# --- Carga del modelo ---
# true  = usa el modelo local (data-science/models/modelo.joblib o MODEL_PATH)
# false = lo descarga desde OCI Object Storage
USE_LOCAL_MODEL=true

# Ruta explícita al modelo (opcional; si se define, tiene prioridad sobre las rutas por defecto)
# MODEL_PATH=data-science/models/modelo.joblib

# --- OCI Object Storage (solo si USE_LOCAL_MODEL=false) ---
# OCI_BUCKET=energiai-models
# MODEL_OBJECT_NAME=modelo.joblib
# OCI_NAMESPACE=
# OCI_CONFIG_PROFILE=DEFAULT
